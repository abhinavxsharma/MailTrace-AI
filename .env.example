# MAILTRACE AI - Environment Configuration Example
# Copy this file to .env for local development

# Database configuration (defaults to local SQLite for hackathon MVP)
DATABASE_URL=sqlite:///./mailtrace.db

# Allowed CORS origins (comma-separated for frontend integrations)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Threat Intelligence (Optional placeholders)
# Path to local MaxMind GeoLite2 City/ASN database if available
MAXMIND_DB_PATH=

# VirusTotal API Key for domain/IP reputation lookups (optional)
VIRUSTOTAL_API_KEY=
